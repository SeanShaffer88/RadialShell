<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="RadialShell"
    Manufacturer="RadialShell Project"
    Version="$(var.Version)"
    UpgradeCode="{F2F68E53-8C60-4878-8896-E722715A5A4D}"
    Scope="perUser"
    InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of RadialShell is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="RadialShell" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
    </Feature>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="InstallFolder" Name="RadialShell" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ApplicationFiles">
      <Component Id="ApplicationExecutable" Directory="InstallFolder" Guid="*">
        <File Id="RadialShellExe" Source="$(var.PublishDir)\RadialShell.exe" KeyPath="yes" />
      </Component>
      <Component Id="LoginStartupRegistration" Directory="InstallFolder" Guid="*">
        <RegistryValue
          Root="HKCU"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="RadialShell"
          Type="string"
          Value="&quot;[InstallFolder]RadialShell.exe&quot;"
          KeyPath="yes" />
      </Component>
      <Files Include="$(var.PublishDir)\**" Directory="InstallFolder">
        <Exclude Files="$(var.PublishDir)\RadialShell.exe" />
      </Files>
    </ComponentGroup>

    <CustomAction
      Id="LaunchRadialShellAfterInstall"
      FileRef="RadialShellExe"
      ExeCommand=""
      Return="asyncNoWait"
      Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom
        Action="LaunchRadialShellAfterInstall"
        After="InstallFinalize"
        Condition="NOT Installed AND UILevel &gt; 2" />
    </InstallExecuteSequence>
  </Package>
</Wix>
